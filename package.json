{
  "scripts": {
    "audit:ci": "pnpm audit",
    "build": "pnpm build-only && node scripts/package-theme.mjs",
    "build-only": "rolldown -c",
    "format:check": "prettier --check 'templates/**/*.html' theme.yaml settings.yaml package.json rolldown.config.mjs 'scripts/**/*.mjs' '.github/**/*.yml'",
    "prepare": "husky",
    "prettier": "prettier --write 'templates/**/*.html'",
    "verify:package": "node scripts/verify-theme-package.mjs --zip",
    "verify:source": "node scripts/verify-theme-package.mjs"
  },
  "lint-staged": {
    "*.html": [
      "prettier --write"
    ],
    "{annotation-setting,settings,theme}.yaml": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.1.1",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "js-yaml": "4.3.2",
    "less": "4.8.1",
    "lint-staged": "^15.5.2",
    "postcss": "8.5.26",
    "prettier": "^3.9.5",
    "rolldown": "1.0.0-beta.58",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "pnpm": {
    "overrides": {
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "postcss@>=8.0.0 <8.5.26": "8.5.26",
      "yaml@<1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "svgo@>=1.0.0 <2.8.4": "2.8.4",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "colord@<2.9.4": "2.9.4",
      "probe-image-size@<=7.3.0": "7.4.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "minimatch@<11.0.1": "11.0.1",
      "glob@>=9.0.0 <=14.0.1": "14.0.2"
    }
  },
  "packageManager": "pnpm@10.26.0"
}
